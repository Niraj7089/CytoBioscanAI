{
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "models/**",
        "reports/**",
        "src/**",
        "data/sensor/**",
        "data/raw/test/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
